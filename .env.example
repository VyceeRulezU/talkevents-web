# Copy to .env.local and fill in. Never commit real values.
# Used by scripts and deploys run from this machine, not by the website itself.

# Cloudflare account and domain (IDs)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# R2 media bucket (apps/web/scripts/upload-media.mjs)
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_S3_ENDPOINT=
R2_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_POOLER_HOST=
SUPABASE_DB_POOLER_USER=
SUPABASE_DB_PASSWORD=
