{
  // Cloudflare Worker serving talkevents.ng as static assets: the Astro build
  // output in ./dist is uploaded as-is (no Worker script). Used both by the
  // dashboard's Git builds and by `npx wrangler deploy` from this folder.
  // No secrets belong in this file — set them in the Cloudflare dashboard or
  // with `wrangler secret put <KEY>`.
  "name": "talkevents-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // /about is served from about.html; /about/ redirects to /about.
    "html_handling": "drop-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
