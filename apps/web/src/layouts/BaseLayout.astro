---
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/700.css';
// Mrs Saint Delafield is a documented brand accent (--font-script) but no
// component currently sets it — section titles dropped their script word
// (design-system.md §2). Re-add the import if the accent comes back.

import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/layout.css';
import '@/styles/utilities.css';

import Seo from '@/components/seo/Seo.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import SkipLink from '@/components/layout/SkipLink.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppFab from '@/components/layout/WhatsAppFab.astro';
import BackToTop from '@/components/layout/BackToTop.astro';
import { organizationSchema, websiteSchema } from '@/lib/schema';
import { mediaUrl } from '@/data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  person?: { givenName: string; familyName: string };
  noindex?: boolean;
}

const { title, description, path, image, imageAlt, type, person, noindex } = Astro.props;
---

<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="2CQ7u8Gr1m5XMuNH1wx8WRWJO7sTZqpc8R7o0M8tmfs" />
    <Seo title={title} description={description} path={path} image={image} imageAlt={imageAlt} type={type} person={person} noindex={noindex} />
    <link rel="preconnect" href={mediaUrl} />
    <slot name="head" />
    <JsonLd schema={organizationSchema()} />
    <JsonLd schema={websiteSchema()} />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <WhatsAppFab />
  </body>
</html>
