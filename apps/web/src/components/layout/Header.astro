---
import Button from '@/components/ui/Button.astro';
import { primaryCta, primaryNav, site } from '@/data/site';

const currentPath = new URL(Astro.request.url).pathname;
---

<header class="header">
  <div class="header__inner">
    <a href="/" class="header__logo" aria-label={`${site.name}, home`}>
      <img src="/te-logo-bw-compact.png" alt={site.name} width="490" height="84" />
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul role="list" class="header__nav-list">
        {primaryNav.map((link) => (
          <li>
            <a
              href={link.href}
              class="header__nav-link"
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <span class="header__cta">
      <Button href={primaryCta.href} variant="accent-subtle" arrow>{primaryCta.label}</Button>
    </span>

    <details class="header__mobile-nav">
      <summary class="header__mobile-toggle" aria-label="Menu">
        <svg class="icon-menu" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="header__mobile-panel">
        <ul role="list" class="header__mobile-list">
          {primaryNav.map((link) => (
            <li>
              <a href={link.href} class="header__mobile-link">{link.label}</a>
            </li>
          ))}
        </ul>
        <Button href={primaryCta.href} variant="accent-subtle" arrow class="header__mobile-cta">{primaryCta.label}</Button>
      </div>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu when a link inside it is followed.
  const mobileNav = document.querySelector('.header__mobile-nav');
  mobileNav?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.tagName === 'A' && mobileNav instanceof HTMLDetailsElement) {
      mobileNav.open = false;
    }
  });
</script>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    height: var(--header-height);
    display: flex;
    align-items: center;
    background: var(--color-surface-page);
    border-block-end: var(--border-width) solid var(--color-border-subtle);
  }

  .header__inner {
    width: 100%;
    max-width: var(--container-header);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: 100%;
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    margin-inline-end: auto;
  }

  .header__logo img {
    /* Compact crop is ~5.8:1 (tight-cropped mark + wordmark, tagline and
       excess whitespace removed) — height is tuned for on-screen width,
       not for parity with the old height value used on the full lockup. */
    height: 1.9rem;
    width: auto;
  }

  .header__nav {
    display: none;
  }

  .header__nav-list {
    display: flex;
    gap: var(--space-6);
  }

  .header__nav-link {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-default);
    padding-block: var(--space-2);
    border-block-end: var(--border-width-strong) solid transparent;
  }

  .header__nav-link:hover,
  .header__nav-link[aria-current='page'] {
    color: var(--color-brand-accent-text);
    border-block-end-color: var(--color-brand-accent-text);
  }

  .header__cta {
    display: none;
  }

  .header__mobile-nav {
    margin-inline-start: auto;
  }

  .header__mobile-toggle {
    list-style: none;
    display: grid;
    place-items: center;
    width: var(--tap-target-min);
    height: var(--tap-target-min);
    color: var(--color-text-default);
    cursor: pointer;
  }

  .header__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .icon-close {
    display: none;
  }

  .header__mobile-nav[open] .icon-menu {
    display: none;
  }

  .header__mobile-nav[open] .icon-close {
    display: block;
  }

  .header__mobile-toggle svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .header__mobile-panel {
    display: none;
  }

  .header__mobile-nav[open] .header__mobile-panel {
    display: flex;
    flex-direction: column;
    position: fixed;
    inset-block-start: var(--header-height);
    inset-inline: 0;
    inset-block-end: 0;
    background: var(--color-surface-page);
    padding: var(--space-6) var(--gutter);
    overflow-y: auto;
  }

  .header__mobile-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .header__mobile-link {
    display: block;
    padding-block: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    text-decoration: none;
    color: var(--color-text-strong);
    border-block-end: var(--border-width) solid var(--color-border-subtle);
  }

  /* Button doesn't set width/margin itself, so no scoping conflict here
     (unlike display/border-radius above, which needed the span wrapper). */
  :global(.header__mobile-cta) {
    width: 100%;
    margin-block-start: auto;
  }

  @media (min-width: 64rem) {
    .header__inner {
      display: grid;
      grid-template-columns: auto 1fr auto;
    }

    .header__logo {
      margin-inline-end: 0;
    }

    .header__logo img {
      height: 1.6rem;
    }

    .header__nav {
      display: flex;
      justify-content: center;
    }

    .header__cta {
      display: inline-flex;
    }

    .header__mobile-nav {
      display: none;
    }
  }
</style>
