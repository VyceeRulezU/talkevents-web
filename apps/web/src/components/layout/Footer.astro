---
import Botanical from '@/components/ui/Botanical.astro';
import { footerNav, legalNav, serviceNav, site } from '@/data/site';

const year = new Date().getFullYear();

// Unconfirmed profiles are tracked placeholders in site.ts — never link them.
const socials = (
  [
    { label: 'Instagram', href: site.socials.instagram, icon: 'instagram' },
    { label: 'Facebook', href: site.socials.facebook, icon: 'facebook' },
    { label: 'TikTok', href: site.socials.tiktok, icon: 'tiktok' },
  ] as const
).filter((social) => !social.href.startsWith('{{'));

const { address } = site.contact;
---

<footer id="footer" class="footer surface-dark">
  <div class="container container--header footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        <img
          class="footer__logo"
          src="/te-logo-gw.svg"
          alt={site.name}
          width="220"
          height="100"
          loading="lazy"
        />
        <p class="footer__blurb">{site.description}</p>
        <ul role="list" class="footer__socials">
          {socials.map((social) => (
            <li>
              <a href={social.href} class="footer__social" rel="me noopener" target="_blank">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  {social.icon === 'instagram' && (
                    <>
                      <rect x="4" y="4" width="16" height="16" rx="4.5" />
                      <circle cx="12" cy="12" r="3.6" />
                      <path d="M16.6 7.4h.01" />
                    </>
                  )}
                  {social.icon === 'facebook' && (
                    <path d="M14 8.5V7c0-.8.5-1.2 1.2-1.2H17V3h-2.4C12 3 10.6 4.7 10.6 7v1.5H8.2v3h2.4V21H14v-9.5h2.6l.4-3Z" />
                  )}
                  {social.icon === 'tiktok' && (
                    <path d="M14 3v11.2a3.3 3.3 0 1 1-3.3-3.3M14 3c.3 2.6 1.9 4.3 4.5 4.6" />
                  )}
                </svg>
                <span class="visually-hidden">{social.label} (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav class="footer__col" aria-label="Footer">
        <h2 class="footer__heading">Explore</h2>
        <ul role="list" class="footer__list">
          {footerNav.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Services">
        <h2 class="footer__heading">Services</h2>
        <ul role="list" class="footer__list">
          {serviceNav.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__heading">Get in touch</h2>
        <ul role="list" class="footer__list footer__list--contact">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" />
              <path d="m4 7 8 6 8-6" />
            </svg>
            <a href={`mailto:${site.contact.email}`}><span class="visually-hidden">Email: </span>{site.contact.email}</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z" />
            </svg>
            <a href={site.contact.phoneHref}><span class="visually-hidden">Phone: </span>{site.contact.phone}</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" />
              <circle cx="12" cy="10" r="2.4" />
            </svg>
            <span>
              <span class="visually-hidden">Address: </span>{address.streetAddress}<br />
              {address.addressLocality}, Nigeria
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <ul role="list" class="footer__legal">
        {legalNav.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer__meadow">
    <Botanical variant="meadow" />
  </div>
</footer>

<style>
  .footer {
    position: relative;
    min-block-size: 100vh;
    min-block-size: 100dvh;
    display: flex;
    overflow: hidden;
    background: var(--color-surface-inverse);
  }

  .footer__inner {
    position: relative;
    z-index: var(--z-raised);
    display: flex;
    flex-direction: column;
    padding-block: var(--space-8) var(--space-6);
  }

  /* Line-art botanicals rising from the bottom edge, laid over the footer
     surface and under its content. */
  .footer__meadow {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 38%;
    color: var(--color-brand-accent);
    opacity: 0.28;
    pointer-events: none;
  }

  .footer__grid {
    /* Takes the free height so the columns sit centred above the bottom bar. */
    flex: 1;
    display: grid;
    gap: var(--space-7);
    grid-template-columns: 1fr;
    align-content: center;
    padding-block-end: var(--space-7);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .footer__logo {
    inline-size: var(--logo-footer-width);
    block-size: auto;
  }

  .footer__blurb {
    max-inline-size: var(--measure-narrow);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .footer__socials {
    display: flex;
    gap: var(--space-2);
  }

  .footer__social {
    display: grid;
    place-items: center;
    inline-size: var(--tap-target-min);
    block-size: var(--tap-target-min);
    margin-inline-start: calc(var(--space-3) * -1);
    border-radius: var(--radius-circle);
    transition: color var(--duration-base) var(--ease-standard);
  }

  .footer :where(svg) {
    flex-shrink: 0;
    inline-size: var(--icon-size-sm);
    block-size: var(--icon-size-sm);
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-strong);
    margin-block-end: var(--space-5);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .footer__list a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
  }

  .footer__list--contact li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    overflow-wrap: anywhere;
  }

  .footer__list--contact svg {
    color: var(--color-text-strong);
  }

  .footer__list a:hover,
  .footer__legal a:hover,
  .footer__social:hover {
    color: var(--color-text-link);
  }

  .footer__bottom {
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border-default);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__legal {
    display: flex;
    gap: var(--space-5);
  }

  .footer__legal a {
    color: inherit;
    text-decoration: none;
  }

  @media (min-width: 30rem) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1.1fr 1.4fr;
      gap: var(--space-8);
    }

    .footer__brand {
      grid-column: auto;
    }

    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
