---
import { footerNav, legalNav, site } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="footer surface-dark">
  <div class="container footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        <img
          src="/brand/reference/talkevents-logo-on-dark.png"
          alt={site.name}
          width="150"
          height="38"
          loading="lazy"
        />
        <p class="footer__tagline">{site.tagline}</p>
        <a href={site.socials.instagram} class="footer__social" rel="me noopener" target="_blank">
          Instagram <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </div>

      <nav class="footer__col" aria-label="Footer">
        <h2 class="footer__heading">Explore</h2>
        <ul role="list" class="footer__list">
          {footerNav.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__heading">Contact</h2>
        <ul role="list" class="footer__list">
          <li>{site.contact.address.addressLocality}, {site.contact.address.addressRegion}</li>
          <li>{site.contact.phone}</li>
          <li>{site.contact.email}</li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <ul role="list" class="footer__legal">
        {legalNav.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-8) var(--space-6);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: 1fr;
    padding-block-end: var(--space-7);
    border-block-end: var(--border-width) solid var(--color-border-default);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .footer__tagline {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .footer__social {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-block-end: var(--space-4);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .footer__list a {
    text-decoration: none;
  }

  .footer__list a:hover {
    color: var(--color-text-link);
  }

  .footer__bottom {
    padding-block-start: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer__legal {
    display: flex;
    gap: var(--space-5);
  }

  .footer__legal a {
    text-decoration: none;
  }

  .footer__legal a:hover {
    color: var(--color-text-link);
  }

  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
