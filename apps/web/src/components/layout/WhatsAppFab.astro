---
import { whatsappCtaLabel, whatsappHref } from '@/data/site';

const currentPath = new URL(Astro.request.url).pathname;
const hiddenOn = ['/contact', '/book'];
const isHidden = hiddenOn.includes(currentPath);
---

{!isHidden && (
  <a
    class="whatsapp-fab"
    href={whatsappHref()}
    target="_blank"
    rel="noopener"
    aria-label={whatsappCtaLabel}
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.7.8-.8 1-.2.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.1.2-.2.2-.4.1-.1.1-.3 0-.4-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9 0 1.1.8 2.2.9 2.4.1.2 1.6 2.5 3.9 3.4.5.2 1 .4 1.3.5.5.2 1 .1 1.4.1.4-.1 1.3-.5 1.5-1 .2-.5.2-.9.1-1Z"
      />
    </svg>
    <span class="visually-hidden">{whatsappCtaLabel}</span>
  </a>
)}

<style>
  .whatsapp-fab {
    position: fixed;
    inset-block-end: max(var(--space-5), env(safe-area-inset-bottom));
    inset-inline-end: max(var(--space-5), env(safe-area-inset-right));
    z-index: var(--z-floating);
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-circle);
    background: var(--palette-green-600);
    color: var(--palette-white);
    box-shadow: var(--shadow-md);
    transition: background-color var(--duration-base) var(--ease-standard);
  }

  .whatsapp-fab:hover {
    background: var(--palette-green-700);
  }

  .whatsapp-fab svg {
    width: 1.75rem;
    height: 1.75rem;
  }
</style>
