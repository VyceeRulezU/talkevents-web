---
import { media } from '@/data/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';

// Logos supplied by the client. Only add a partner here with their written
// permission (docs/open-questions.md #7).
// `scale` evens out the optical size: the round marks carry a lot of empty
// canvas, so at the same height they read far smaller than the wordmarks.
const partners = [
  { name: 'NaliGrid', src: media('/images/partners/nali-grid.svg'), width: 3946, height: 1454, scale: 1, href: 'https://naligrid.com' },
  { name: 'Aliza Events', src: media('/images/partners/aliza-events.png'), width: 500, height: 500, scale: 1.9 },
  { name: 'Blue Velvet', src: media('/images/partners/blue-velvet.svg'), width: 244, height: 252, scale: 1.5 },
  { name: 'Qmara Vie Planners', src: media('/images/partners/qmara-vie-planners.png'), width: 808, height: 360, scale: 1.1 },
  // Solid artwork on a white ground: flattening it to one ink would leave a
  // blob, so it is greyed instead and its white ground is blended away.
  { name: 'Premier Chilling Services', src: media('/images/partners/premier-chilling-services.png'), width: 880, height: 475, scale: 1.25, solid: true },
];
---

<div class="logo-strip">
  <SectionHeading heading="Our Partners" align="center" />

  <ul role="list" class="logo-strip__list">
    {partners.map((partner) => (
      <li class:list={['logo-strip__item', 'solid' in partner && 'logo-strip__item--solid']} style={`--logo-scale: ${partner.scale}`}>
        {'href' in partner ? (
          <a href={partner.href} target="_blank" rel="noopener" class="logo-strip__link">
            <img src={partner.src} alt={partner.name} width={partner.width} height={partner.height} loading="lazy" decoding="async" />
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        ) : (
          <img src={partner.src} alt={partner.name} width={partner.width} height={partner.height} loading="lazy" decoding="async" />
        )}
      </li>
    ))}
  </ul>
</div>

<style>
  .logo-strip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-7);
  }

  .logo-strip__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-6) var(--space-8);
    inline-size: 100%;
  }

  .logo-strip__item {
    display: flex;
  }

  /* The files arrive in mixed colours (one is white-on-transparent), so every
     logo is flattened to a single ink and shown as one quiet, even row. */
  .logo-strip__item img {
    inline-size: auto;
    block-size: calc(var(--logo-partner-height) * var(--logo-scale, 1));
    max-inline-size: 100%;
    object-fit: contain;
    filter: brightness(0);
    opacity: 0.8;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  .logo-strip__item:hover img,
  .logo-strip__link:focus-visible img {
    opacity: 1;
  }

  .logo-strip__link {
    display: flex;
  }

  .logo-strip__item--solid img {
    filter: grayscale(1) contrast(1.15);
    mix-blend-mode: multiply;
  }
</style>
