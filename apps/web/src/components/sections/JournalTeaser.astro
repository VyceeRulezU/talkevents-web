---
import SectionHeading from '@/components/ui/SectionHeading.astro';

// Seed topics tracked in docs/content-plan.md — articles not yet written.
const posts = [
  { title: 'How much does a wedding cost in Abuja?', href: '/journal' },
  { title: 'A realistic Abuja wedding planning timeline', href: '/journal' },
  { title: 'Questions to ask before booking an event planner', href: '/journal' },
];
---

<SectionHeading eyebrow="From the journal" heading="Planning guides" level="h2" />

<ul role="list" class="journal-teaser">
  {posts.map((post) => (
    <li class="journal-teaser__item">
      <a href={post.href}>{post.title}</a>
    </li>
  ))}
</ul>

<style>
  .journal-teaser {
    margin-block-start: var(--space-6);
    display: grid;
    gap: var(--space-4);
  }

  .journal-teaser__item {
    padding-block: var(--space-4);
    border-block-end: var(--border-width) solid var(--color-border-subtle);
  }

  .journal-teaser__item a {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    text-decoration: none;
  }

  .journal-teaser__item a:hover {
    color: var(--color-text-link);
  }

  @media (min-width: 48rem) {
    .journal-teaser {
      grid-template-columns: repeat(3, 1fr);
    }

    .journal-teaser__item {
      border-block-end: none;
      border-inline-start: var(--border-width-strong) solid var(--color-brand-accent);
      padding-inline-start: var(--space-4);
      padding-block: 0;
    }
  }
</style>
