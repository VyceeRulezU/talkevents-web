---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Botanical from '@/components/ui/Botanical.astro';

type Quote = {
  /** One entry per paragraph, in the client's own words. */
  quote: string[];
  name: string;
  event: string;
  /** Optional portrait in /public — only with the client's written consent (NDPA). */
  avatar?: string;
};

// Real client words only — never fabricate or reword a testimonial. Add more
// here as the client shares them (with consent); with two or more, the section
// becomes an auto-advancing carousel on its own.
const quotes: Quote[] = [
  {
    // From the client's own testimonial card (Family Fish Grilling Festival 2026).
    quote: [
      'Let me sincerely express my appreciation and say thank you very much for the opportunity to work with you.',
      'It was truly a great experience, and I genuinely admire your professionalism and creativity.',
      'I strongly believe you will go far in this career, and I pray for greater doors, bigger opportunities, and continuous wins for you.',
      'Looking forward to working with you again on future opportunities. Thank you once again.',
    ],
    name: 'Planning committee chair',
    event: 'Family Fish Grilling Festival 2026',
  },
];

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((word) => word[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<div class="testimonials" data-testimonials>
  <span class="testimonials__sprig testimonials__sprig--start"><Botanical /></span>
  <span class="testimonials__sprig testimonials__sprig--end"><Botanical /></span>

  <header class="testimonials__header">
    <SectionHeading heading="Kind Words" align="center" id="testimonials-heading" />
    <span class="testimonials__ornament" aria-hidden="true"></span>
  </header>

  {/* Without JS (or before it runs) this is a plain list of every quote. */}
  <ul role="list" class="testimonials__slides" aria-labelledby="testimonials-heading">
    {quotes.map((item, index) => (
      <li class="testimonial" data-testimonial-slide aria-label={`${index + 1} of ${quotes.length}`}>
        <figure class="testimonial__figure">
          <blockquote class="testimonial__quote">
            <span class="testimonial__mark" aria-hidden="true">&ldquo;</span>
            <div class="testimonial__text">
              {item.quote.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <span class="testimonial__mark" aria-hidden="true">&rdquo;</span>
          </blockquote>
          <figcaption class="testimonial__author">
            {item.avatar ? (
              <img class="testimonial__avatar" src={item.avatar} alt="" width="64" height="64" loading="lazy" decoding="async" />
            ) : (
              <span class="testimonial__avatar" aria-hidden="true">{initials(item.name)}</span>
            )}
            <span class="testimonial__name">{item.name}</span>
            <span class="testimonial__event">{item.event}</span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>

  <div class="testimonials__controls" hidden data-testimonial-controls>
    {quotes.map((_, index) => (
      <button type="button" class="testimonials__dot" aria-label={`Show testimonial ${index + 1}`} data-testimonial-dot />
    ))}
  </div>
</div>

<script>
  // Looping, auto-advancing carousel. It pauses on hover, on keyboard focus
  // and while the tab is hidden, and never auto-advances for visitors who
  // prefer reduced motion (they still get the dots).
  const INTERVAL_MS = 6000;

  for (const root of document.querySelectorAll<HTMLElement>('[data-testimonials]')) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-testimonial-slide]')];
    const controls = root.querySelector<HTMLElement>('[data-testimonial-controls]');
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-testimonial-dot]')];
    if (slides.length < 2 || !controls) continue;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer: number | undefined;
    let hovering = false;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.dataset.active = String(active);
        slide.inert = !active;
      });
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === current)));
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (reducedMotion.matches || hovering || document.hidden) return;
      timer = window.setInterval(() => show(current + 1), INTERVAL_MS);
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      }),
    );

    const hold = (value: boolean) => () => {
      hovering = value;
      start();
    };
    root.addEventListener('mouseenter', hold(true));
    root.addEventListener('mouseleave', hold(false));
    root.addEventListener('focusin', hold(true));
    root.addEventListener('focusout', hold(false));
    document.addEventListener('visibilitychange', start);

    root.dataset.enhanced = 'true';
    controls.hidden = false;
    show(0);
    start();
  }
</script>

<style>
  .testimonials {
    position: relative;
    min-block-size: calc(100vh - var(--header-height));
    min-block-size: calc(100dvh - var(--header-height));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-7);
    padding: var(--space-8) var(--gutter);
    overflow: hidden;
    text-align: center;
  }

  /* Line-art sprigs growing in from the two bottom corners. */
  .testimonials__sprig {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    display: none;
    inline-size: clamp(var(--space-10), 20vw, calc(var(--space-10) * 3));
    block-size: 80%;
    color: var(--color-border-default);
  }

  .testimonials__sprig--end {
    inset-inline: auto 0;
    transform: scaleX(-1);
  }

  .testimonials__header {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .testimonials__ornament {
    position: relative;
    inline-size: var(--space-7);
    block-size: var(--border-width);
    background-color: var(--color-border-default);
  }

  .testimonials__ornament::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: var(--space-2);
    block-size: var(--space-2);
    background-color: var(--color-text-muted);
    outline: var(--space-1) solid var(--color-surface-page);
    transform: translate(-50%, -50%) rotate(45deg) scale(0.6);
  }

  .testimonials__slides {
    position: relative;
    display: grid;
    gap: var(--space-7);
    inline-size: 100%;
    max-inline-size: var(--container-narrow);
  }

  /* Once enhanced, every slide shares one grid cell and they cross-fade. */
  [data-enhanced] .testimonials__slides {
    gap: 0;
  }

  [data-enhanced] .testimonial {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateX(var(--space-5));
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out),
      visibility 0s linear var(--duration-slow);
  }

  [data-enhanced] .testimonial[data-active='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .testimonial__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    margin: 0;
  }

  .testimonial__quote {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
  }

  .testimonial__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .testimonial__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-default);
    text-wrap: balance;
  }

  .testimonial__mark {
    display: none;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--color-border-default);
  }

  .testimonial__author {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .testimonial__avatar {
    display: grid;
    place-items: center;
    inline-size: var(--icon-size-lg);
    block-size: var(--icon-size-lg);
    margin-block-end: var(--space-2);
    border-radius: var(--radius-circle);
    border: var(--border-width) solid var(--color-border-default);
    background: var(--color-surface-tint);
    color: var(--color-brand-primary);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-wide);
    object-fit: cover;
  }

  .testimonial__name {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-strong);
  }

  .testimonial__event {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .testimonials__controls {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .testimonials__controls[hidden] {
    display: none;
  }

  .testimonials__dot {
    display: grid;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    padding: 0;
    border: 0;
    border-radius: var(--radius-circle);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .testimonials__dot::before {
    content: '';
    inline-size: var(--space-2);
    block-size: var(--space-2);
    border-radius: var(--radius-circle);
    background: var(--color-border-default);
    transition: background-color var(--duration-base) var(--ease-standard);
  }

  .testimonials__dot:hover::before,
  .testimonials__dot[aria-current='true']::before {
    background: var(--color-brand-primary);
  }

  @media (min-width: 48rem) {
    .testimonials__sprig {
      display: block;
    }

    .testimonial__mark {
      display: block;
    }
  }
</style>
