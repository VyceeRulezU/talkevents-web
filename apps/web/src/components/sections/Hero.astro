---
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import PlaceholderMedia from '@/components/ui/PlaceholderMedia.astro';
import { primaryCta, whatsappCtaLabel, whatsappHref } from '@/data/site';
---

<section class="hero surface-dark" aria-label="Introduction">
  <div class="hero__media">
    <PlaceholderMedia label="Placeholder — real event photography pending" />
  </div>

  <div class="hero__card">
    <Eyebrow>Abuja event coordination &amp; planning</Eyebrow>
    <h1 class="hero__title">Your plan, perfectly executed</h1>
    <p class="hero__body">
      Talk Events plans and runs weddings, corporate events and celebrations across Abuja —
      organised, on time, with no surprises on the day.
    </p>
    <div class="hero__actions">
      <Button href={primaryCta.href} variant="accent">{primaryCta.label}</Button>
      <Button href={whatsappHref()} variant="outline">{whatsappCtaLabel}</Button>
    </div>
  </div>

  <a href="#services" class="hero__scroll-cue" aria-label="Scroll to services">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 4v16m0 0-6-6m6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--overlay-hero);
  }

  .hero__card {
    position: relative;
    z-index: var(--z-raised);
    background: var(--color-surface-page);
    color: var(--color-text-default);
    max-width: 32rem;
    padding: var(--space-6) var(--space-6) var(--space-7);
    margin: var(--space-6);
    box-shadow: var(--shadow-hero-card);
  }

  .hero__title {
    font-size: var(--text-4xl);
    margin-block-end: var(--space-4);
  }

  .hero__body {
    color: var(--color-text-muted);
    max-width: var(--measure-narrow);
    margin-block-end: var(--space-5);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__actions :global(.button--outline) {
    color: var(--color-text-default);
    border-color: var(--color-border-default);
  }

  .hero__actions :global(.button--outline:hover) {
    background: var(--color-surface-subtle);
  }

  .hero__scroll-cue {
    position: absolute;
    inset-block-end: var(--space-6);
    inset-inline-end: var(--space-6);
    z-index: var(--z-raised);
    display: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-circle);
    border: var(--border-width) solid var(--color-border-on-dark);
    color: var(--color-text-on-dark);
  }

  .hero__scroll-cue svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (min-width: 48rem) {
    .hero__scroll-cue {
      display: grid;
    }
  }
</style>
