---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import LineIcon from '@/components/ui/LineIcon.astro';

type Service = {
  title: string;
  href: string;
  summary: string;
  icon: 'rings' | 'calendar' | 'toast';
  image: {
    /** Basename in /public/images — a .jpg and .webp of each must exist. */
    name: string;
    alt: string;
    width: number;
    height: number;
    /** Where the cover-crop anchors. */
    position: string;
  };
};

// Candidate services per PRD §10 FR-S3 — [CONFIRM] with client before launch.
// Temporary decor-only stock photos (Pexels, free-to-use license, no
// identifiable people) standing in for the client's own photography until
// real assets are supplied and moved to R2.
const services: Service[] = [
  {
    title: 'Wedding planning',
    href: '/services#weddings',
    summary: 'Introduction, traditional and white wedding, run end to end.',
    icon: 'rings',
    image: {
      name: 'service-wedding-decor',
      alt: 'Long banquet tables leading to a floral backdrop under green draping, set for a traditional wedding',
      width: 1200,
      height: 800,
      position: 'center',
    },
  },
  {
    title: 'Corporate events',
    href: '/services#corporate-events',
    summary: 'Conferences, launches and staff events, on spec and on schedule.',
    icon: 'calendar',
    image: {
      name: 'service-corporate-hall',
      alt: 'Rows of chairs set out either side of a central aisle in a conference hall',
      width: 1200,
      height: 800,
      position: 'center',
    },
  },
  {
    title: 'Birthdays & milestones',
    href: '/services#celebrations',
    summary: 'Milestone birthdays, naming ceremonies and family celebrations.',
    icon: 'toast',
    image: {
      name: 'service-celebration-table',
      alt: 'A long celebration table dressed with white flowers, gold-rimmed plates and balloons',
      width: 1200,
      height: 1500,
      position: 'center 40%',
    },
  },
];
---

<div class="services">
  <header class="services__header">
    <SectionHeading heading="Our Services" align="center" />
    <span class="services__ornament" aria-hidden="true"></span>
  </header>

  <ul role="list" class="service-grid">
    {services.map((service) => (
      <li class="service-tile">
        <a href={service.href} class="service-tile__link">
          <picture class="service-tile__media">
            <source srcset={`/images/${service.image.name}.webp`} type="image/webp" />
            <img
              src={`/images/${service.image.name}.jpg`}
              alt={service.image.alt}
              width={service.image.width}
              height={service.image.height}
              style={`object-position: ${service.image.position}`}
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="service-tile__content">
            <span class="service-tile__icon">
              <LineIcon name={service.icon} />
            </span>
            <h3 class="service-tile__title">{service.title}</h3>
            <p class="service-tile__summary">{service.summary}</p>
            <span class="service-tile__cta">
              Learn more
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 12h16m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .services {
    /* The section fills the viewport; the tiles stretch to fill whatever the
       heading leaves, so the row grows and shrinks with the window. */
    min-block-size: calc(100vh - var(--header-height));
    min-block-size: calc(100dvh - var(--header-height));
    display: flex;
    flex-direction: column;
    padding-block: var(--space-8);
  }

  .services__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-7);
  }

  /* Hairline with a diamond at its centre. */
  .services__ornament {
    position: relative;
    inline-size: var(--space-7);
    block-size: var(--border-width);
    background-color: var(--color-border-default);
  }

  .services__ornament::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: var(--space-2);
    block-size: var(--space-2);
    background-color: var(--color-text-muted);
    outline: var(--space-1) solid var(--color-surface-page);
    transform: translate(-50%, -50%) rotate(45deg) scale(0.6);
  }

  .service-grid {
    flex: 1;
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: 1fr;
    grid-auto-rows: 1fr;
  }

  .service-tile {
    display: flex;
  }

  .service-tile__link {
    position: relative;
    flex: 1;
    display: flex;
    min-block-size: var(--tile-min-height);
    text-decoration: none;
    color: var(--color-text-on-dark);
    overflow: hidden;
  }

  .service-tile__link:focus-visible {
    outline-color: var(--color-focus-ring-on-dark);
    outline-offset: calc(var(--space-1) * -1);
  }

  .service-tile__media {
    position: absolute;
    inset: 0;
    display: block;
  }

  .service-tile__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .service-tile__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--overlay-tile);
  }

  .service-tile__link:hover .service-tile__media img,
  .service-tile__link:focus-visible .service-tile__media img {
    transform: scale(1.04);
  }

  .service-tile__content {
    position: relative;
    z-index: var(--z-raised);
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4);
    padding: var(--space-7) var(--space-5);
    text-align: center;
  }

  .service-tile__icon {
    display: flex;
    --icon-size: var(--space-7);
  }

  .service-tile__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: inherit;
  }

  .service-tile__summary {
    max-inline-size: calc(var(--measure-narrow) * 2 / 3);
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-text-on-dark-muted);
    text-wrap: balance;
  }

  .service-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .service-tile__cta svg {
    inline-size: var(--space-4);
    block-size: var(--space-4);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .service-tile__link:hover .service-tile__cta,
  .service-tile__link:focus-visible .service-tile__cta {
    color: var(--color-brand-accent);
  }

  .service-tile__link:hover .service-tile__cta svg,
  .service-tile__link:focus-visible .service-tile__cta svg {
    transform: translateX(var(--space-1));
  }

  @media (min-width: 48rem) {
    .service-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
