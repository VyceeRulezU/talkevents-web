---
import { media } from '@/data/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';

interface Props {
  /** `row`: one paged row with arrows (home). `grid`: every photo, wrapped (portfolio). */
  layout?: 'row' | 'grid';
}

const { layout = 'row' } = Astro.props;
const grid = layout === 'grid';

// Temporary decor-only stock photos (Pexels, free-to-use license, no
// identifiable people) standing in for the client's own event photography.
const rowPhotos = [
  { name: 'featured-candlelit-table', alt: 'A candlelit banquet table dressed with flowers and glassware at a reception in Lagos', width: 1000, height: 668 },
  { name: 'featured-red-gold-reception', alt: 'Round reception tables with tall red floral centrepieces and gold chairs before a draped stage', width: 1000, height: 667 },
  { name: 'gallery-white-tables', alt: 'Round tables dressed in white with matching chairs and tall candelabra', width: 1000, height: 1500 },
  { name: 'featured-warm-hall', alt: 'A warmly lit hall of tables with gold satin chair sashes facing an illuminated head table', width: 1000, height: 667 },
  { name: 'gallery-purple-hall', alt: 'A banquet hall of round tables and gold-framed chairs washed in purple light', width: 1000, height: 667 },
  { name: 'featured-garden-banquet', alt: 'A long banquet table under hanging greenery, lined with white flowers and gold chairs', width: 1000, height: 668 },
  { name: 'gallery-chandelier-hall', alt: 'A reception hall of white-draped tables beneath a crystal chandelier', width: 1000, height: 1294 },
  { name: 'featured-gold-centrepiece', alt: 'A round table set in ivory and gold around a candelabra and white floral centrepiece', width: 1000, height: 667 },
];

const morePhotos = [
  { name: 'service-wedding-decor', alt: 'Long banquet tables leading to a floral backdrop under green draping, set for a traditional wedding', width: 1200, height: 800 },
  { name: 'service-corporate-hall', alt: 'Rows of chairs set out either side of a central aisle in a conference hall', width: 1200, height: 800 },
  { name: 'service-celebration-table', alt: 'A long celebration table dressed with white flowers, gold-rimmed plates and balloons', width: 1200, height: 1500 },
  { name: 'cta-wedding-hands', alt: 'A bride and groom holding hands during a Nigerian wedding ceremony', width: 1920, height: 1280 },
];

const photos = grid ? [...rowPhotos, ...morePhotos] : rowPhotos;
---

<div class:list={['gallery', grid && 'gallery--grid']}>
  <header class="gallery__header">
    <SectionHeading heading="Our Gallery" align="center" id="gallery-heading" />
    <span class="gallery__ornament" aria-hidden="true"></span>
  </header>

  <ul role="list" class="gallery__track" tabindex={grid ? undefined : 0} aria-labelledby={grid ? undefined : 'gallery-heading'} aria-label={grid ? 'Photos' : undefined} data-gallery-track>
    {photos.map((photo, index) => (
      <li class="gallery__item">
        <button type="button" class="gallery__open" aria-label={`Open photo ${index + 1} of ${photos.length}`} data-gallery-open={index}>
          <picture>
            <source srcset={media(`/images/${photo.name}.webp`)} type="image/webp" />
            <img src={media(`/images/${photo.name}.jpg`)} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
          </picture>
        </button>
      </li>
    ))}
  </ul>

  <div class="gallery__footer">
    <a href="/portfolio" class="gallery__more">
      See more
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M4 12h16m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

    <div class="gallery__controls">
      <button type="button" class="gallery__arrow" aria-label="Previous photos" data-gallery-step="-1">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="m14 7-5 5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button type="button" class="gallery__arrow" aria-label="Next photos" data-gallery-step="1">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="m10 7 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>

  <dialog class="lightbox" aria-label="Gallery photo" data-gallery-lightbox>
    <button type="button" class="lightbox__button lightbox__close" aria-label="Close photo" data-lightbox-close>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
    <button type="button" class="lightbox__button lightbox__prev" aria-label="Previous photo" data-lightbox-step="-1">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="m14 7-5 5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <figure class="lightbox__figure">
      <img class="lightbox__image" alt="" data-lightbox-image />
      <figcaption class="lightbox__caption">
        <span data-lightbox-caption></span>
        <span class="lightbox__count" data-lightbox-count></span>
      </figcaption>
    </figure>
    <button type="button" class="lightbox__button lightbox__next" aria-label="Next photo" data-lightbox-step="1">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="m10 7 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </dialog>
</div>

<script>
  // The track is a native scroller (swipe, wheel and keyboard work without JS);
  // the arrows just page it by one photo and disable at either end.
  for (const track of document.querySelectorAll<HTMLElement>('[data-gallery-track]')) {
    const arrows = track.parentElement?.querySelectorAll<HTMLButtonElement>('[data-gallery-step]') ?? [];

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      for (const arrow of arrows) {
        const forward = arrow.dataset.galleryStep === '1';
        arrow.disabled = forward ? track.scrollLeft >= max - 1 : track.scrollLeft <= 1;
      }
    };

    for (const arrow of arrows) {
      arrow.addEventListener('click', () => {
        const item = track.querySelector<HTMLElement>('.gallery__item');
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        const step = (item?.offsetWidth ?? track.clientWidth) + gap;
        track.scrollBy({ left: step * Number(arrow.dataset.galleryStep) });
      });
    }

    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();

    // Lightbox: a native <dialog>, so Esc closes it, focus is trapped while it
    // is open and returns to the photo that opened it.
    const lightbox = track.parentElement?.querySelector<HTMLDialogElement>('[data-gallery-lightbox]');
    const image = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = lightbox?.querySelector<HTMLElement>('[data-lightbox-caption]');
    const count = lightbox?.querySelector<HTMLElement>('[data-lightbox-count]');
    const openers = [...track.querySelectorAll<HTMLButtonElement>('[data-gallery-open]')];
    if (!lightbox || !image || typeof lightbox.showModal !== 'function') continue;

    let current = 0;

    const show = (index: number) => {
      current = (index + openers.length) % openers.length;
      const thumb = openers[current].querySelector('img');
      if (!thumb) return;
      image.src = thumb.currentSrc || thumb.src;
      image.alt = thumb.alt;
      if (caption) caption.textContent = thumb.alt;
      if (count) count.textContent = `${current + 1} / ${openers.length}`;
    };

    openers.forEach((opener, index) =>
      opener.addEventListener('click', () => {
        show(index);
        lightbox.showModal();
      }),
    );

    for (const button of lightbox.querySelectorAll<HTMLButtonElement>('[data-lightbox-step]')) {
      button.addEventListener('click', () => show(current + Number(button.dataset.lightboxStep)));
    }

    lightbox.querySelector('[data-lightbox-close]')?.addEventListener('click', () => lightbox.close());

    // A click on the dark surround (the dialog itself, not its contents) closes it.
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });

    lightbox.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    // Keep the row in step, so closing lands on the photo last viewed.
    lightbox.addEventListener('close', () => {
      openers[current].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      openers[current].focus({ preventScroll: true });
    });
  }
</script>

<style>
  .gallery {
    /* One screen below the navbar; the photo row takes whatever the heading
       and the footer row leave. */
    min-block-size: calc(100vh - var(--header-height));
    min-block-size: calc(100dvh - var(--header-height));
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .gallery__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  /* Hairline with a diamond at its centre. */
  .gallery__ornament {
    position: relative;
    inline-size: var(--space-7);
    block-size: var(--border-width);
    background-color: var(--color-border-default);
  }

  .gallery__ornament::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: var(--space-2);
    block-size: var(--space-2);
    background-color: var(--color-text-muted);
    outline: var(--space-1) solid var(--color-surface-tint);
    transform: translate(-50%, -50%) rotate(45deg) scale(0.6);
  }

  .gallery__track {
    --gallery-visible: 1.25;
    flex: 1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--grid-gap) * (var(--gallery-visible) - 1)) / var(--gallery-visible));
    gap: var(--grid-gap);
    min-block-size: var(--tile-min-height);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  .gallery__item {
    position: relative;
    overflow: hidden;
    scroll-snap-align: start;
  }

  .gallery__open {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .gallery__open:focus-visible {
    outline-offset: calc(var(--border-width-strong) * -1);
  }

  .gallery__item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .gallery__item:hover img,
  .gallery__open:focus-visible img {
    transform: scale(1.04);
  }

  .gallery__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .gallery__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--tap-target-min);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.4em;
    color: var(--color-text-link);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .gallery__more svg {
    inline-size: var(--space-5);
    block-size: var(--space-5);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .gallery__more:hover {
    color: var(--color-text-link-hover);
  }

  .gallery__more:hover svg {
    transform: translateX(var(--space-1));
  }

  .gallery__controls {
    display: flex;
    gap: var(--space-3);
  }

  .gallery__arrow {
    display: grid;
    place-items: center;
    inline-size: var(--tap-target-min);
    block-size: var(--tap-target-min);
    padding: 0;
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-circle);
    background: var(--color-surface-card);
    color: var(--color-text-strong);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transition:
      background-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard),
      opacity var(--duration-base) var(--ease-standard);
  }

  .gallery__arrow svg {
    inline-size: var(--icon-size-sm);
    block-size: var(--icon-size-sm);
  }

  .gallery__arrow:hover:not(:disabled) {
    background: var(--color-brand-primary);
    color: var(--color-text-on-dark);
  }

  .gallery__arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* Grid layout: every photo, wrapped, at one tile shape. No heading, paging
     or "see more" — the page supplies its own intro. */
  .gallery--grid {
    min-block-size: 0;
    padding-block: 0;
  }

  .gallery--grid .gallery__header,
  .gallery--grid .gallery__footer {
    display: none;
  }

  .gallery--grid .gallery__track {
    --gallery-columns: 2;
    grid-auto-flow: row;
    grid-auto-columns: auto;
    grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
    min-block-size: 0;
    overflow: visible;
    scroll-snap-type: none;
  }

  .gallery--grid .gallery__item {
    aspect-ratio: var(--aspect-gallery);
  }

  @media (min-width: 48rem) {
    .gallery--grid .gallery__track {
      --gallery-columns: 3;
    }
  }

  @media (min-width: 64rem) {
    .gallery--grid .gallery__track {
      --gallery-columns: 4;
    }
  }

  .lightbox {
    inline-size: 100%;
    block-size: 100%;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: var(--space-8) var(--gutter) var(--space-6);
    border: 0;
    background: var(--overlay-lightbox);
    color: var(--color-text-on-dark);
  }

  .lightbox[open] {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
  }

  .lightbox::backdrop {
    background: var(--overlay-lightbox);
  }

  .lightbox__figure {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    min-block-size: 0;
    block-size: 100%;
    margin: 0;
  }

  .lightbox__image {
    flex: 1;
    min-block-size: 0;
    max-inline-size: 100%;
    object-fit: contain;
  }

  .lightbox__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-on-dark-muted);
    text-align: center;
  }

  .lightbox__count {
    letter-spacing: var(--tracking-wide);
    font-variant-numeric: tabular-nums;
  }

  .lightbox__button {
    display: grid;
    place-items: center;
    inline-size: var(--tap-target-min);
    block-size: var(--tap-target-min);
    padding: 0;
    border: var(--border-width) solid var(--color-border-on-dark);
    border-radius: var(--radius-circle);
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background-color var(--duration-base) var(--ease-standard);
  }

  .lightbox__button:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .lightbox__button:focus-visible {
    outline-color: var(--color-focus-ring-on-dark);
  }

  .lightbox__button svg {
    inline-size: var(--icon-size-sm);
    block-size: var(--icon-size-sm);
  }

  .lightbox__prev {
    grid-column: 1;
    grid-row: 1;
  }

  .lightbox__next {
    grid-column: 3;
    grid-row: 1;
  }

  .lightbox__close {
    position: absolute;
    inset-block-start: var(--space-4);
    inset-inline-end: var(--gutter);
  }

  /* On narrow screens the photo takes the full width and the arrows drop
     to a row beneath it. */
  @media (max-width: 47.9375rem) {
    .lightbox[open] {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
    }

    .lightbox__figure {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .lightbox__prev {
      grid-column: 1;
      grid-row: 2;
      justify-self: end;
    }

    .lightbox__next {
      grid-column: 2;
      grid-row: 2;
      justify-self: start;
    }
  }

  @media (min-width: 48rem) {
    .gallery__track {
      --gallery-visible: 2;
    }
  }

  @media (min-width: 64rem) {
    .gallery__track {
      --gallery-visible: 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__track {
      scroll-behavior: auto;
    }
  }
</style>
