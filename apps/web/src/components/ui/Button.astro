---
interface Props {
  href?: string;
  variant?: 'primary' | 'accent' | 'accent-subtle' | 'outline' | 'text';
  type?: 'button' | 'submit';
  /** Append an outward arrow (e.g. "Book now ↗"). Inline SVG — see design-system.md §6. */
  arrow?: boolean;
  class?: string;
}

const { href, variant = 'primary', type = 'button', arrow = false, class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class:list={['button', `button--${variant}`, className]}
>
  <slot />
  {arrow && (
    <svg class="button__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M7 7h10v10M7 17 17 7" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--tap-target-min);
    height: var(--button-height);
    padding-inline: var(--button-padding-inline);
    border-radius: var(--radius-none);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border: var(--border-width) solid transparent;
    transition: background-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard);
  }

  .button--primary {
    background: var(--color-brand-primary);
    color: var(--color-text-on-dark);
  }

  .button--primary:hover {
    background: var(--color-brand-primary-hover);
  }

  .button--accent {
    background: var(--color-brand-accent);
    color: var(--color-text-on-accent);
  }

  .button--accent:hover {
    background: var(--color-brand-accent-hover);
  }

  /* Muted, glossy green fill — the site's default CTA (header, hero). Kept
     apart from --accent (bright mark green), which reads better as a small
     highlight than a full button fill. */
  .button--accent-subtle {
    background-color: var(--color-cta-subtle);
    background-image: var(--overlay-gloss);
    color: var(--color-text-on-dark);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.4), var(--shadow-sm);
  }

  .button--accent-subtle:hover {
    background-color: var(--color-cta-subtle-hover);
  }

  .button--outline {
    background: transparent;
    color: var(--color-text-on-dark);
    border-color: var(--color-border-on-dark);
  }

  .button--outline:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .button--text {
    height: auto;
    min-height: 0;
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-text-link);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .button--text:hover {
    color: var(--color-text-link-hover);
  }

  .button__icon {
    width: 1.4em;
    height: 1.4em;
    flex-shrink: 0;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .button:hover .button__icon {
    transform: translate(2px, -2px);
  }
</style>
