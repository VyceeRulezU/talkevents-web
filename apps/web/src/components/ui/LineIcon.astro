---
interface Props {
  /** Name from the house line-art set. */
  name: 'bloom' | 'botanical' | 'rings' | 'toast' | 'calendar' | 'snowflake' | 'glass' | 'usher';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['line-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'bloom' && (
    <>
      <path d="M12 11.5c-2.2 0-3.4-1.9-3.4-3.9C8.6 5.1 10.2 4.4 12 4.4s3.4.7 3.4 3.2c0 2-1.2 3.9-3.4 3.9Z" />
      <path d="M12 11.5c-2.2 0-3.4-1.9-3.4-3.9C8.6 5.1 10.2 4.4 12 4.4s3.4.7 3.4 3.2c0 2-1.2 3.9-3.4 3.9Z" transform="rotate(90 12 12)" />
      <path d="M12 11.5c-2.2 0-3.4-1.9-3.4-3.9C8.6 5.1 10.2 4.4 12 4.4s3.4.7 3.4 3.2c0 2-1.2 3.9-3.4 3.9Z" transform="rotate(180 12 12)" />
      <path d="M12 11.5c-2.2 0-3.4-1.9-3.4-3.9C8.6 5.1 10.2 4.4 12 4.4s3.4.7 3.4 3.2c0 2-1.2 3.9-3.4 3.9Z" transform="rotate(270 12 12)" />
      <circle cx="12" cy="12" r="1.1" />
    </>
  )}

  {name === 'botanical' && (
    <>
      <path d="M12 20.5V6" />
      <path d="M12 18c2.2 0 3.6-1.3 3.6-3.3-2.2 0-3.6 1.3-3.6 3.3Z" />
      <path d="M12 14.5c-2.2 0-3.6-1.3-3.6-3.3 2.2 0 3.6 1.3 3.6 3.3Z" />
      <path d="M12 11c1.8 0 2.9-1.1 2.9-2.7-1.8 0-2.9 1.1-2.9 2.7Z" />
      <circle cx="12" cy="4.6" r="1.6" />
    </>
  )}

  {name === 'rings' && (
    <>
      <circle cx="9.5" cy="13.5" r="5.5" />
      <circle cx="14.5" cy="13.5" r="5.5" />
      <path d="M17 3.6 18.6 5.6 17 7.6 15.4 5.6Z" />
    </>
  )}

  {name === 'toast' && (
    <>
      <path d="M4.8 4.6h4.4c0 2.9-.7 4.7-2.2 4.7s-2.2-1.8-2.2-4.7Z" />
      <path d="M7 9.3v6.1" />
      <path d="M4.9 15.4h4.2" />
      <path d="M14.8 4.6h4.4c0 2.9-.7 4.7-2.2 4.7s-2.2-1.8-2.2-4.7Z" />
      <path d="M17 9.3v6.1" />
      <path d="M14.9 15.4h4.2" />
      <circle cx="7" cy="2.6" r="0.8" />
      <circle cx="12" cy="1.6" r="0.6" />
      <circle cx="16.8" cy="2.9" r="0.8" />
    </>
  )}

  {name === 'calendar' && (
    <>
      <path d="M4.5 6h15v13.5h-15Z" />
      <path d="M4.5 10h15" />
      <path d="M8.5 3.5v4" />
      <path d="M15.5 3.5v4" />
      <path d="M8.5 13.5h.01M12 13.5h.01M15.5 13.5h.01M8.5 16.5h.01M12 16.5h.01" />
    </>
  )}

  {name === 'snowflake' && (
    <>
      <path d="M12 3v18" />
      <path d="M4.2 7.5l15.6 9" />
      <path d="M19.8 7.5l-15.6 9" />
      <path d="M9.6 4.6 12 7l2.4-2.4" />
      <path d="M9.6 19.4 12 17l2.4 2.4" />
    </>
  )}

  {name === 'glass' && (
    <>
      <path d="M5 4.5h14l-7 8Z" />
      <path d="M7.6 7.5h8.8" />
      <path d="M12 12.5V20" />
      <path d="M8.5 20h7" />
    </>
  )}

  {name === 'usher' && (
    <>
      <circle cx="9" cy="8" r="3" />
      <path d="M3.5 19.5c0-3.2 2.4-5.5 5.5-5.5s5.5 2.3 5.5 5.5" />
      <circle cx="16.8" cy="9" r="2.3" />
      <path d="M16.4 14.2c2.5.3 4.1 2.3 4.1 5.3" />
    </>
  )}
</svg>

<style>
  .line-icon {
    display: block;
    inline-size: var(--icon-size, var(--icon-size-sm));
    block-size: var(--icon-size, var(--icon-size-sm));
  }

  /* The icons are drawn on the house 24px grid at 1.5px, but the benefit set
     renders them much larger — non-scaling-stroke keeps that 1.5px honest so
     the line art stays delicate instead of ballooning with the viewport. */
  .line-icon :where(path, circle) {
    vector-effect: non-scaling-stroke;
  }
</style>
