---
// Stand-in for real event photography until the client supplies a photo
// library (see docs/open-questions.md #16). Decorative — real images must
// carry descriptive alt text per design-system.md §5.
interface Props {
  label: string;
  class?: string;
  tone?: 'blue' | 'ink';
}

const { label, class: className, tone = 'blue' } = Astro.props;
---

<div class:list={['placeholder-media', `placeholder-media--${tone}`, className]} aria-hidden="true">
  <span class="placeholder-media__label">{label}</span>
</div>

<style>
  .placeholder-media {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--palette-blue-800), var(--palette-blue-600));
  }

  .placeholder-media--ink {
    background: linear-gradient(135deg, var(--palette-ink-900), var(--palette-ink-600));
  }

  .placeholder-media__label {
    margin: var(--space-3);
    padding: var(--space-1) var(--space-3);
    background: rgb(0 0 0 / 0.45);
    color: var(--color-text-on-dark);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    border-radius: var(--radius-sm);
  }
</style>
