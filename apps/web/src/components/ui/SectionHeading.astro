---
import Eyebrow from '@/components/ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  /** One word inside `heading` to render in the script accent font. Must appear verbatim in `heading`. */
  scriptWord?: string;
  level?: 'h1' | 'h2' | 'h3';
  id?: string;
  align?: 'start' | 'center';
  class?: string;
}

const { eyebrow, heading, scriptWord, level = 'h2', id, align = 'start', class: className } = Astro.props;
const Tag = level;

const parts = scriptWord && heading.includes(scriptWord) ? heading.split(scriptWord) : null;
---

<div class:list={['section-heading', align === 'center' && 'section-heading--center', className]}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <Tag id={id} class="section-heading__title">
    {parts ? (
      <>
        {parts[0]}<span class="section-heading__script">{scriptWord}</span>{parts[1]}
      </>
    ) : (
      heading
    )}
  </Tag>
</div>

<style>
  .section-heading {
    max-width: var(--measure-prose);
  }

  .section-heading--center {
    max-width: none;
    text-align: center;
    margin-inline: auto;
  }

  .section-heading__title {
    margin: 0;
  }

  .section-heading__script {
    font-family: var(--font-script);
    font-weight: var(--font-weight-regular);
    font-size: var(--text-script);
    line-height: 1;
    display: inline-block;
    vertical-align: middle;
    color: var(--color-brand-accent-text);
  }
</style>
