---
import Eyebrow from '@/components/ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  level?: 'h1' | 'h2' | 'h3';
  id?: string;
  align?: 'start' | 'center';
  class?: string;
}

const { eyebrow, heading, level = 'h2', id, align = 'start', class: className } = Astro.props;
const Tag = level;
---

<div class:list={['section-heading', align === 'center' && 'section-heading--center', className]}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <Tag id={id} class="section-heading__title">
    {heading}
  </Tag>
</div>

<style>
  .section-heading {
    max-width: var(--measure-prose);
  }

  .section-heading--center {
    max-width: none;
    text-align: center;
    margin-inline: auto;
  }

  /* One heading language site-wide: light display serif, uppercase, generous
     tracking. Left-aligned by default so it still reads as a section opener. */
  .section-heading__title {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-light);
    line-height: var(--leading-snug);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
</style>
