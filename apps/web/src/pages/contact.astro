---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PageHero from '@/components/sections/PageHero.astro';
import EnquiryForm from '@/components/sections/EnquiryForm.astro';
import { mapHref, site, whatsappHref } from '@/data/site';

const { address } = site.contact;
---

<BaseLayout
  title="Contact Talk Events | Abuja Event Planners"
  description="Call, email or send an enquiry to Talk Events in Maitama, Abuja to plan your wedding, corporate event or celebration."
  path="/contact"
>
  <PageHero eyebrow="Get in touch" title="Tell us about your event" />

  <Section ariaLabel="Contact details and enquiry form">
    <Container width="header">
      <div class="contact">
        <div class="contact__details">
          <SectionHeading eyebrow="Contact" heading="Talk to us" />
          <p class="contact__lede">
            Call, email or send the form and we will come back to you. If you already know your date
            and guest numbers, the <a href="/book">booking form</a> gets us to a proposal faster.
          </p>

          <ul role="list" class="contact__list">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z" />
              </svg>
              <div>
                <h3>Phone</h3>
                <a href={site.contact.phoneHref}>{site.contact.phone}</a>
              </div>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M4 20l1.3-4.2A8 8 0 1 1 8.3 19L4 20Z" />
                <path d="M9.3 8.8c0 3 2.9 5.9 5.9 5.9l1-1.600-1.900-1-.9.9c-.9-.4-1.900-1.400-2.300-2.300l.9-.9-1-1.900-1.700.9Z" />
              </svg>
              <div>
                <h3>WhatsApp</h3>
                <a href={whatsappHref()} target="_blank" rel="noopener">
                  Chat on {site.contact.phone} <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </div>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" />
                <path d="m4 7 8 6 8-6" />
              </svg>
              <div>
                <h3>Email</h3>
                <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
              </div>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" />
                <circle cx="12" cy="10" r="2.4" />
              </svg>
              <div>
                <h3>Office</h3>
                <address>
                  {address.streetAddress}<br />
                  {address.addressLocality}, Nigeria
                </address>
                <a href={mapHref} target="_blank" rel="noopener">
                  Open in Google Maps <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </div>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="4" y="4" width="16" height="16" rx="4.5" />
                <circle cx="12" cy="12" r="3.6" />
                <path d="M16.6 7.4h.01" />
              </svg>
              <div>
                <h3>Instagram</h3>
                <a href={site.socials.instagram} target="_blank" rel="me noopener">
                  @_talkevents <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </div>
            </li>
          </ul>
        </div>

        <div class="contact__form">
          <h2 class="contact__form-title">Send an enquiry</h2>
          <EnquiryForm variant="short" id="contact-form" />
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact__lede {
    max-inline-size: var(--measure-narrow);
    margin: 0;
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .contact__lede a,
  .contact__list a {
    color: var(--color-text-link);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .contact__lede a:hover,
  .contact__list a:hover {
    color: var(--color-text-link-hover);
  }

  .contact__list {
    display: flex;
    flex-direction: column;
    margin-block-start: var(--space-3);
  }

  .contact__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border-subtle);
  }

  .contact__list svg {
    flex-shrink: 0;
    inline-size: var(--icon-size-sm);
    block-size: var(--icon-size-sm);
    margin-block-start: var(--space-1);
    color: var(--color-brand-primary);
  }

  .contact__list h3 {
    margin: 0 0 var(--space-1);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact__list address {
    margin-block-end: var(--space-2);
    font-style: normal;
  }

  .contact__form-title {
    margin: 0 0 var(--space-5);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-light);
  }

  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: var(--space-9);
    }
  }
</style>
