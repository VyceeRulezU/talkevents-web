---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Prose from '@/components/ui/Prose.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { site } from '@/data/site';

// DRAFT — website terms of use only. Booking terms (deposits, cancellations)
// are deliberately left to the written agreement: they are not confirmed yet
// (docs/open-questions.md #11). Needs the client's legal review (#22).
---

<BaseLayout
  title="Terms of Use | Talk Events"
  description="The terms that apply when you use the Talk Events website and send us an enquiry."
  path="/terms"
>
  <PageHero eyebrow="Legal" title="Terms of use" />

  <Section ariaLabel="Terms of use">
    <Container width="header">
      <Prose>
        <p class="prose__meta">Last updated: 6 October 2026</p>

        <p>
          These terms apply to your use of the {site.name} website. By using the site you agree to
          them. If you do not agree, please do not use the site.
        </p>

        <h2>About this website</h2>
        <p>
          This website describes the event planning and coordination services offered by {site.name}
          in Abuja, Nigeria, and lets you get in touch with us. We aim to keep the information on it
          accurate and up to date, but it is provided for general information and may change without
          notice.
        </p>

        <h2>Enquiries and bookings</h2>
        <p>
          Sending an enquiry or booking request through this website does not create a contract and
          does not reserve a date. A booking is confirmed only when you and {site.name} have agreed
          the scope and fees in writing. The terms of that written agreement, including payment and
          cancellation, govern the event and take priority over anything on this website.
        </p>

        <h2>Using the site</h2>
        <p>You agree not to:</p>
        <ul>
          <li>use the site for anything unlawful or to send false or misleading enquiries;</li>
          <li>attempt to interfere with the site’s security or normal operation;</li>
          <li>use automated tools to copy the site’s content without our permission.</li>
        </ul>

        <h2>Our content</h2>
        <p>
          The text, design, logos and photographs on this website belong to {site.name} or are used
          with permission. You may view and share pages for personal, non-commercial use. Please ask
          us before reproducing any of it elsewhere.
        </p>

        <h2>Links to other websites</h2>
        <p>
          The site links to services we do not control, such as WhatsApp, Instagram and Google Maps.
          We are not responsible for their content or for how they handle your information.
        </p>

        <h2>Our responsibility to you</h2>
        <p>
          We provide this website as it is. To the extent the law allows, we are not liable for any
          loss arising from your use of the site or from relying on the information on it. Nothing in
          these terms limits any liability that cannot be limited under Nigerian law.
        </p>

        <h2>Privacy</h2>
        <p>
          Our <a href="/privacy">privacy policy</a> and <a href="/cookies">cookie policy</a> explain
          how we handle your personal information.
        </p>

        <h2>Changes to these terms</h2>
        <p>
          We may update these terms from time to time. The date at the top of the page shows when
          they were last changed.
        </p>

        <h2>Governing law</h2>
        <p>These terms are governed by the laws of the Federal Republic of Nigeria.</p>

        <h2>Contact us</h2>
        <p>
          Questions about these terms can be sent to
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> or by phone on
          <a href={site.contact.phoneHref}>{site.contact.phone}</a>.
        </p>
      </Prose>
    </Container>
  </Section>
</BaseLayout>
