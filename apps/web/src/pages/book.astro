---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PageHero from '@/components/sections/PageHero.astro';
import EnquiryForm from '@/components/sections/EnquiryForm.astro';
import { site } from '@/data/site';

const next = [
  { title: 'We read your enquiry', body: 'Everything you tell us here goes straight to the planning team.' },
  { title: 'We talk it through', body: 'A consultation to understand your vision, guest count and budget.' },
  { title: 'You get a proposal', body: 'A plan, a timeline and a vendor shortlist for you to approve.' },
];
---

<BaseLayout
  title="Book Talk Events | Plan Your Event in Abuja"
  description="Tell Talk Events about your wedding, corporate event or celebration in Abuja in three short steps and get a plan and proposal back."
  path="/book"
>
  <PageHero eyebrow="Book now" title="Let’s plan your event" />

  <Section tint ariaLabel="Booking enquiry">
    <Container width="header">
      <div class="book">
        <div class="book__aside">
          <SectionHeading eyebrow="Three short steps" heading="Start with the basics" />
          <p class="book__lede">
            Tell us what you are planning and how to reach you. It takes about two minutes, and you
            do not need every detail fixed to begin.
          </p>

          <h3 class="book__next-title">What happens next</h3>
          <ol role="list" class="book__next">
            {next.map((step, index) => (
              <li>
                <span class="book__next-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h4>{step.title}</h4>
                  <p>{step.body}</p>
                </div>
              </li>
            ))}
          </ol>

          <p class="book__direct">
            Rather talk? Call <a href={site.contact.phoneHref}>{site.contact.phone}</a> or email
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
          </p>
        </div>

        <EnquiryForm variant="steps" id="booking-form" />
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .book {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  .book__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .book__lede {
    max-inline-size: var(--measure-narrow);
    margin: 0;
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .book__next-title {
    margin: var(--space-3) 0 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .book__next {
    display: flex;
    flex-direction: column;
  }

  .book__next li {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border-default);
  }

  .book__next-number {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--color-brand-accent-text);
  }

  .book__next h4 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-lg);
  }

  .book__next p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .book__direct {
    margin: 0;
    font-size: var(--text-sm);
  }

  .book__direct a {
    color: var(--color-text-link);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 64rem) {
    .book {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--space-9);
    }

    .book__aside {
      position: sticky;
      inset-block-start: calc(var(--header-height) + var(--space-6));
    }
  }
</style>
