---
import { media } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { premierChilling } from '@/data/site';

// Candidate services per PRD §10 FR-S3. The "what we take care of" lists are
// a draft scope — [CONFIRM] each line with the client before launch.
// Photos: temporary decor-only stock (Pexels, free-to-use license).
const services = [
  {
    id: 'weddings',
    eyebrow: 'Weddings',
    heading: 'Wedding planning and coordination',
    body: [
      'Introduction, traditional wedding and white wedding, planned as one joined-up celebration or as separate days. We carry the plan from the first venue visit to the last dance, and keep both families working from the same page.',
      'Whether you want us beside you from the start or need a steady hand for the final weeks and the day itself, we shape the support around what you still have left to do.',
    ],
    includes: [
      'Venue search, visits and bookings',
      'Vendor sourcing, briefing and management',
      'Budget planning and tracking',
      'Guest logistics and aso ebi coordination',
      'Timeline, programme and rehearsal',
      'Full coordination on the day',
    ],
    type: 'wedding',
    image: { name: 'service-wedding-decor', alt: 'Long banquet tables leading to a floral backdrop under green draping, set for a traditional wedding', width: 1200, height: 800 },
  },
  {
    id: 'corporate-events',
    eyebrow: 'Corporate events',
    heading: 'Conferences, launches and company events',
    body: [
      'Conferences, product launches, award nights, retreats and staff events, delivered to your brief, your brand and your schedule. We handle the logistics so your team can focus on the content and the guests.',
      'You get a clear plan up front, a single contact throughout, and an on-site team that keeps the programme running to time.',
    ],
    includes: [
      'Venue sourcing and room layout',
      'Registration and guest management',
      'Stage, sound, screens and lighting coordination',
      'Catering and hospitality',
      'Speaker and programme management',
      'On-site event team',
    ],
    type: 'corporate',
    image: { name: 'service-corporate-hall', alt: 'Rows of chairs set out either side of a central aisle in a conference hall', width: 1200, height: 800 },
  },
  {
    id: 'celebrations',
    eyebrow: 'Birthdays and milestones',
    heading: 'Birthdays and milestone celebrations',
    body: [
      'Milestone birthdays, naming ceremonies, anniversaries, send-forths and family celebrations. Tell us who you are celebrating and how you want the room to feel, and we will build the day around it.',
      'From an intimate dinner to a full hall, the planning is the same: a clear programme, vendors who know their brief, and a team that sets up, runs the day and clears down.',
    ],
    includes: [
      'Theme and styling direction',
      'Venue and vendor booking',
      'Invitations and guest list support',
      'Cake, catering and entertainment coordination',
      'Programme and MC briefing',
      'Set-up, coordination and clear-down',
    ],
    type: 'birthday',
    image: { name: 'service-celebration-table', alt: 'A long celebration table dressed with white flowers, gold-rimmed plates and balloons', width: 1200, height: 1500 },
  },
  {
    id: 'cooling',
    eyebrow: 'Cooling services',
    heading: 'Cooling by Premier Chilling Services',
    partner: true,
    body: [
      'A warm drink is the detail guests remember for the wrong reason. Premier Chilling Services, our sister company, keeps everything cold from the first toast to the last guest.',
      'The cooling is planned around your guest numbers, your menu and your venue, set up before doors open, and looked after through the event so your hosts never have to think about it.',
    ],
    includes: [
      'Ice supplied and topped up through the event',
      'Chillers and cold storage on site',
      'Quantities planned for your guest list',
      'Set-up before your guests arrive',
      'A team to manage it on the day',
      'Clear-down when the event ends',
    ],
    type: 'something',
    image: { name: 'service-cooling-ice-bucket', alt: 'Bottles chilling in a large metal bucket of ice at an outdoor event', width: 1200, height: 800 },
  },
  {
    id: 'drinks',
    eyebrow: 'Drinks services',
    heading: 'Drinks planned, stocked and served',
    partner: true,
    body: [
      'What to serve, how much of it, and how it reaches every table on time: we plan the drinks for your event with the same care as the rest of the day, and deliver the service with Premier Chilling Services.',
      'You agree the menu and the budget. We work out the quantities, set up the service points and make sure nobody is left waiting with an empty glass.',
    ],
    includes: [
      'Drinks menu planned with you',
      'Quantities worked out for your guest list',
      'Bar and service points set up',
      'Servers to keep every table supplied',
      'Drinks kept cold from start to finish',
      'Stock tracked through the event',
    ],
    type: 'something',
    image: { name: 'service-drinks-glasses', alt: 'Rows of filled glasses set out on a table ready to be served', width: 1200, height: 800 },
  },
  {
    id: 'ushering',
    eyebrow: 'Ushering services',
    heading: 'A warm welcome and an orderly room',
    body: [
      'Ushers set the tone the moment a guest arrives. Ours welcome people at the door, show them to the right seat and keep the room moving, so the programme starts when it should.',
      'They are briefed on your seating plan, your special guests and your order of events, and they work hand in hand with the coordinator on the day.',
    ],
    includes: [
      'Guest welcome and registration',
      'Seating and table direction',
      'Hosting for families and special guests',
      'Door and crowd management',
      'Support for the MC and the programme',
      'A briefed, well-presented team',
    ],
    type: 'something',
    image: { name: 'gallery-chandelier-hall', alt: 'A reception hall of white-draped tables beneath a crystal chandelier', width: 1000, height: 1294 },
  },
];
---

<BaseLayout
  title="Event Planning, Cooling & Drinks Services in Abuja | Talk Events"
  description="Wedding, corporate and celebration planning in Abuja by Talk Events, with cooling and drinks services from Premier Chilling Services, plus ushering."
  path="/services"
>
  <PageHero eyebrow="What we do" title="Planning and coordination, end to end" />

  {services.map((service, index) => (
    <Section id={service.id} tint={index % 2 === 1} ariaLabel={service.eyebrow} class="service-section">
      <Container width="header">
        <div class:list={['service', index % 2 === 1 && 'service--flip']}>
          <picture class="service__media">
            <source srcset={media(`/images/${service.image.name}.webp`)} type="image/webp" />
            <img
              src={media(`/images/${service.image.name}.jpg`)}
              alt={service.image.alt}
              width={service.image.width}
              height={service.image.height}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </picture>
          <div class="service__copy">
            <SectionHeading eyebrow={service.eyebrow} heading={service.heading} />
            {'partner' in service && (
              <a class="service__partner" href={premierChilling.path}>
                <img src={premierChilling.logo} alt={`${premierChilling.name} logo`} width="880" height="475" loading="lazy" decoding="async" />
                <span>
                  <span>Delivered by <strong>{premierChilling.name}</strong></span>
                  <em>{premierChilling.slogan}</em>
                  <span class="service__partner-more">Visit {premierChilling.name}</span>
                </span>
              </a>
            )}
            {service.body.map((paragraph) => <p>{paragraph}</p>)}
            <h3 class="service__list-title">What we take care of</h3>
            <ul role="list" class="service__list">
              {service.includes.map((item) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                    <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <Button href={`/book?type=${service.type}`} variant="accent-subtle" arrow>Plan my event</Button>
          </div>
        </div>
      </Container>
    </Section>
  ))}

  <Section dark ariaLabel="How we work" class="surface-brand">
    <Container width="header">
      <ProcessSteps />
    </Container>
  </Section>

  <Section ariaLabel="Plan your event" class="section--flush">
    <CtaBand />
  </Section>
</BaseLayout>

<style>
  :global(.section--flush) {
    padding-block: 0;
  }

  /* "Learn more" links from the home page land on these sections. */
  :global(.service-section) {
    scroll-margin-block-start: var(--header-height);
  }

  .service {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .service__media {
    position: relative;
    display: block;
    aspect-ratio: var(--aspect-gallery);
    overflow: hidden;
  }

  .service__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-inline-size: var(--measure-prose);
  }

  .service__copy p {
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .service__partner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    inline-size: 100%;
    padding: var(--space-3) var(--space-4);
    border-inline-start: var(--border-width-strong) solid var(--color-brand-accent);
    background: var(--color-surface-card);
    font-size: var(--text-sm);
    color: inherit;
    text-decoration: none;
    transition: box-shadow var(--duration-base) var(--ease-standard);
  }

  .service__partner:hover {
    box-shadow: var(--shadow-md);
  }

  .service__partner-more {
    color: var(--color-text-link);
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .service__partner img {
    flex-shrink: 0;
    inline-size: auto;
    block-size: var(--space-8);
  }

  .service__partner > span {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .service__partner em {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .service__list-title {
    margin: var(--space-3) 0 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .service__list {
    display: grid;
    gap: var(--space-3) var(--space-6);
    grid-template-columns: 1fr;
    inline-size: 100%;
    margin-block-end: var(--space-3);
    font-size: var(--text-sm);
  }

  .service__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .service__list svg {
    flex-shrink: 0;
    inline-size: var(--icon-size-sm);
    block-size: var(--icon-size-sm);
    color: var(--color-brand-accent-text);
  }

  @media (min-width: 40rem) {
    .service__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .service {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-9);
    }

    .service--flip .service__media {
      order: 2;
    }
  }
</style>
